<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="project.oop.ui.controllers.CheckoutController"
            prefWidth="900" prefHeight="600"
            style="-fx-background-color: #F1EFE8;">

    <left>
        <VBox spacing="0"
              style="-fx-background-color: #185FA5; -fx-pref-width: 210px; -fx-padding: 0;">

            <VBox style="-fx-padding: 24 20 20 20; -fx-background-color: #0C447C;">
                <Label text="Grand Hotel"
                       style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                <Label text="Guest Portal"
                       style="-fx-font-size: 11px; -fx-text-fill: #B5D4F4;"/>
            </VBox>

            <VBox style="-fx-padding: 16 20 16 20; -fx-background-color: #1468B0;">
                <Label text="Welcome back," style="-fx-font-size: 11px; -fx-text-fill: #B5D4F4;"/>
                <Label fx:id="guestNameLabel" text="Guest"
                       style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            </VBox>

            <Button text="Dashboard" onAction="#showDashboard" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #B5D4F4;
                           -fx-font-size: 13px; -fx-alignment: CENTER_LEFT;
                           -fx-padding: 12 20 12 20; -fx-border-width: 0;
                           -fx-background-radius: 0; -fx-cursor: hand;"/>

            <Button text="Browse Rooms" onAction="#showRooms" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #B5D4F4;
                           -fx-font-size: 13px; -fx-alignment: CENTER_LEFT;
                           -fx-padding: 12 20 12 20; -fx-border-width: 0;
                           -fx-background-radius: 0; -fx-cursor: hand;"/>

            <Button text="My Reservations" onAction="#showReservations" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #B5D4F4;
                           -fx-font-size: 13px; -fx-alignment: CENTER_LEFT;
                           -fx-padding: 12 20 12 20; -fx-border-width: 0;
                           -fx-background-radius: 0; -fx-cursor: hand;"/>

            <Button text="Checkout" onAction="#showCheckout" maxWidth="Infinity"
                    style="-fx-background-color: rgba(255,255,255,0.18); -fx-text-fill: white;
                           -fx-font-size: 13px; -fx-alignment: CENTER_LEFT;
                           -fx-padding: 12 20 12 20; -fx-border-width: 0;
                           -fx-background-radius: 0; -fx-cursor: hand; -fx-font-weight: bold;"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Button text="Logout" onAction="#handleLogout" maxWidth="Infinity"
                    style="-fx-background-color: rgba(163,45,45,0.7); -fx-text-fill: white;
                           -fx-font-size: 13px; -fx-alignment: CENTER_LEFT;
                           -fx-padding: 12 20 12 20; -fx-border-width: 0;
                           -fx-background-radius: 0; -fx-cursor: hand;"/>
        </VBox>
    </left>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">
            <VBox spacing="20" style="-fx-padding: 28;">

                <Label text="Checkout and Payment"
                       style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2C2C2A;"/>

                <!-- Step 1 -->
                <VBox spacing="12"
                      style="-fx-background-color: white; -fx-padding: 20;
                             -fx-background-radius: 12; -fx-border-color: #D3D1C7;
                             -fx-border-width: 0.5; -fx-border-radius: 12;">
                    <Label text="Step 1 - Select Reservation"
                           style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #185FA5;"/>
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <Label text="Reservation:" style="-fx-font-size: 13px; -fx-text-fill: #555;"/>
                        <ComboBox fx:id="reservationCombo" prefWidth="300"
                                  onAction="#handleReservationSelected"
                                  promptText="Select a reservation..."
                                  style="-fx-font-size: 13px;"/>
                    </HBox>
                </VBox>

                <!-- Step 2 -->
                <VBox spacing="12"
                      style="-fx-background-color: white; -fx-padding: 20;
                             -fx-background-radius: 12; -fx-border-color: #D3D1C7;
                             -fx-border-width: 0.5; -fx-border-radius: 12;">
                    <Label text="Step 2 - Invoice Summary"
                           style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #185FA5;"/>
                    <GridPane hgap="30" vgap="10">
                        <Label text="Room Number:"     style="-fx-text-fill: #888780; -fx-font-size: 13px;" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                        <Label fx:id="invoiceRoom"     text="-" style="-fx-font-size: 13px; -fx-font-weight: bold;" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                        <Label text="Room Type:"       style="-fx-text-fill: #888780; -fx-font-size: 13px;" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                        <Label fx:id="invoiceType"     text="-" style="-fx-font-size: 13px; -fx-font-weight: bold;" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                        <Label text="Check-In:"        style="-fx-text-fill: #888780; -fx-font-size: 13px;" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                        <Label fx:id="invoiceCheckIn"  text="-" style="-fx-font-size: 13px; -fx-font-weight: bold;" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                        <Label text="Check-Out:"       style="-fx-text-fill: #888780; -fx-font-size: 13px;" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                        <Label fx:id="invoiceCheckOut" text="-" style="-fx-font-size: 13px; -fx-font-weight: bold;" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                        <Label text="Nights:"          style="-fx-text-fill: #888780; -fx-font-size: 13px;" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                        <Label fx:id="invoiceNights"   text="-" style="-fx-font-size: 13px; -fx-font-weight: bold;" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
                        <Label text="Price/Night:"     style="-fx-text-fill: #888780; -fx-font-size: 13px;" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
                        <Label fx:id="invoicePrice"    text="-" style="-fx-font-size: 13px; -fx-font-weight: bold;" GridPane.columnIndex="1" GridPane.rowIndex="5"/>
                    </GridPane>
                    <Separator/>
                    <HBox alignment="CENTER_LEFT" spacing="20">
                        <Label text="TOTAL AMOUNT:"
                               style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #2C2C2A;"/>
                        <Label fx:id="invoiceTotal" text="0.00"
                               style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #185FA5;"/>
                    </HBox>
                </VBox>

                <!-- Step 3 -->
                <VBox spacing="12"
                      style="-fx-background-color: white; -fx-padding: 20;
                             -fx-background-radius: 12; -fx-border-color: #D3D1C7;
                             -fx-border-width: 0.5; -fx-border-radius: 12;">
                    <Label text="Step 3 - Payment Method"
                           style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #185FA5;"/>

                    <fx:define>
                        <ToggleGroup fx:id="paymentGroup"/>
                    </fx:define>

                    <HBox spacing="30" alignment="CENTER_LEFT">
                        <RadioButton fx:id="rbCash"   text="Cash"
                                     toggleGroup="$paymentGroup"
                                     style="-fx-font-size: 13px; -fx-font-family: Arial;"/>
                        <RadioButton fx:id="rbCredit" text="Credit Card"
                                     toggleGroup="$paymentGroup"
                                     style="-fx-font-size: 13px; -fx-font-family: Arial;"/>
                        <RadioButton fx:id="rbOnline" text="Online"
                                     toggleGroup="$paymentGroup"
                                     style="-fx-font-size: 13px; -fx-font-family: Arial;"/>
                    </HBox>

                    <Label fx:id="statusLabel" text="" style="-fx-font-size: 12px; -fx-text-fill: #C0392B;"/>

                    <Button text="Confirm Payment" onAction="#handleConfirmPayment"
                            style="-fx-background-color: #185FA5; -fx-text-fill: white;
                                   -fx-font-size: 14px; -fx-font-weight: bold;
                                   -fx-background-radius: 8; -fx-padding: 10 24 10 24;
                                   -fx-cursor: hand;"/>
                </VBox>

                <!-- Receipt -->
                <VBox fx:id="receiptBox" spacing="10" visible="false" managed="false"
                      style="-fx-background-color: #E8F5E9; -fx-padding: 20;
                             -fx-background-radius: 12; -fx-border-color: #27AE60;
                             -fx-border-width: 1; -fx-border-radius: 12;">
                    <Label text="Payment Successful!"
                           style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #27AE60;"/>
                    <Label fx:id="receiptDetails" text=""
                           style="-fx-font-size: 13px; -fx-text-fill: #2C2C2A;" wrapText="true"/>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
