<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="project.oop.ui.controllers.RegisterController"
            prefWidth="520" prefHeight="600"
            style="-fx-background-color: #F1EFE8;">

    <center>
        <VBox alignment="CENTER" spacing="10"
              style="-fx-background-color: white; -fx-padding: 32 36 28 36;
                     -fx-background-radius: 14;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, 2);"
              maxWidth="440">

            <Label text="🏨 Grand Hotel"
                   style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #185FA5;"/>
            <Label text="Create your guest account"
                   style="-fx-font-size: 13px; -fx-text-fill: #888780;"/>

            <!-- Row 1: Username + Gender -->
            <HBox spacing="12" maxWidth="Infinity">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="Username"
                           style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #5F5E5A;"/>
                    <TextField fx:id="usernameField" promptText="john_doe"
                               style="-fx-pref-height: 34; -fx-background-radius: 8;
                                      -fx-border-radius: 8; -fx-border-color: #B4B2A9;
                                      -fx-border-width: 0.5; -fx-background-color: #F8F8F6;
                                      -fx-font-size: 13px;"
                               maxWidth="Infinity"/>
                </VBox>
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="Gender"
                           style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #5F5E5A;"/>
                    <ComboBox fx:id="genderCombo"
                              style="-fx-pref-height: 34; -fx-background-radius: 8;
                                     -fx-border-radius: 8; -fx-border-color: #B4B2A9;
                                     -fx-border-width: 0.5; -fx-background-color: #F8F8F6;"
                              maxWidth="Infinity"/>
                </VBox>
            </HBox>

            <!-- Password -->
            <VBox spacing="4" maxWidth="Infinity">
                <Label text="Password  (min 8 characters)"
                       style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #5F5E5A;"/>
                <PasswordField fx:id="passwordField" promptText="••••••••"
                               style="-fx-pref-height: 34; -fx-background-radius: 8;
                                      -fx-border-radius: 8; -fx-border-color: #B4B2A9;
                                      -fx-border-width: 0.5; -fx-background-color: #F8F8F6;
                                      -fx-font-size: 13px;"
                               maxWidth="Infinity"/>
            </VBox>

            <!-- Date of Birth -->
            <VBox spacing="4" maxWidth="Infinity">
                <Label text="Date of Birth"
                       style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #5F5E5A;"/>
                <HBox spacing="8">
                    <VBox spacing="2" HBox.hgrow="ALWAYS">
                        <Label text="Year" style="-fx-font-size: 11px; -fx-text-fill: #888780;"/>
                        <TextField fx:id="yearField" promptText="2000"
                                   style="-fx-pref-height: 34; -fx-background-radius: 8;
                                          -fx-border-radius: 8; -fx-border-color: #B4B2A9;
                                          -fx-border-width: 0.5; -fx-background-color: #F8F8F6;"
                                   maxWidth="Infinity"/>
                    </VBox>
                    <VBox spacing="2" HBox.hgrow="ALWAYS">
                        <Label text="Month" style="-fx-font-size: 11px; -fx-text-fill: #888780;"/>
                        <TextField fx:id="monthField" promptText="01"
                                   style="-fx-pref-height: 34; -fx-background-radius: 8;
                                          -fx-border-radius: 8; -fx-border-color: #B4B2A9;
                                          -fx-border-width: 0.5; -fx-background-color: #F8F8F6;"
                                   maxWidth="Infinity"/>
                    </VBox>
                    <VBox spacing="2" HBox.hgrow="ALWAYS">
                        <Label text="Day" style="-fx-font-size: 11px; -fx-text-fill: #888780;"/>
                        <TextField fx:id="dayField" promptText="15"
                                   style="-fx-pref-height: 34; -fx-background-radius: 8;
                                          -fx-border-radius: 8; -fx-border-color: #B4B2A9;
                                          -fx-border-width: 0.5; -fx-background-color: #F8F8F6;"
                                   maxWidth="Infinity"/>
                    </VBox>
                </HBox>
            </VBox>

            <!-- Address -->
            <VBox spacing="4" maxWidth="Infinity">
                <Label text="Address"
                       style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #5F5E5A;"/>
                <TextField fx:id="addressField" promptText="Cairo, Egypt"
                           style="-fx-pref-height: 34; -fx-background-radius: 8;
                                  -fx-border-radius: 8; -fx-border-color: #B4B2A9;
                                  -fx-border-width: 0.5; -fx-background-color: #F8F8F6;
                                  -fx-font-size: 13px;"
                           maxWidth="Infinity"/>
            </VBox>

            <!-- Balance + Room Preference -->
            <HBox spacing="12" maxWidth="Infinity">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="Initial Balance ($)"
                           style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #5F5E5A;"/>
                    <TextField fx:id="balanceField" promptText="500"
                               style="-fx-pref-height: 34; -fx-background-radius: 8;
                                      -fx-border-radius: 8; -fx-border-color: #B4B2A9;
                                      -fx-border-width: 0.5; -fx-background-color: #F8F8F6;"
                               maxWidth="Infinity"/>
                </VBox>
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="Room Preference"
                           style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #5F5E5A;"/>
                    <TextField fx:id="prefField" promptText="Suite"
                               style="-fx-pref-height: 34; -fx-background-radius: 8;
                                      -fx-border-radius: 8; -fx-border-color: #B4B2A9;
                                      -fx-border-width: 0.5; -fx-background-color: #F8F8F6;"
                               maxWidth="Infinity"/>
                </VBox>
            </HBox>

            <!-- Error Label -->
            <Label fx:id="errorLabel" text=""
                   style="-fx-text-fill: #A32D2D; -fx-font-size: 12px;"
                   visible="false" maxWidth="Infinity"/>

            <!-- Register Button -->
            <Button text="Create Account" onAction="#handleRegister"
                    maxWidth="Infinity"
                    style="-fx-background-color: #185FA5; -fx-text-fill: white;
                           -fx-font-size: 14px; -fx-font-weight: bold;
                           -fx-background-radius: 8; -fx-pref-height: 42px; -fx-cursor: hand;"/>

            <!-- Back to login -->
            <HBox alignment="CENTER" spacing="4">
                <Label text="Already have an account?"
                       style="-fx-font-size: 12px; -fx-text-fill: #888780;"/>
                <Hyperlink text="Sign in" onAction="#goToLogin"
                           style="-fx-font-size: 12px; -fx-text-fill: #185FA5;"/>
            </HBox>

        </VBox>
    </center>

</BorderPane>
