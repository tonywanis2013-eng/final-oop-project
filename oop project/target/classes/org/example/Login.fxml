<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="project.oop.ui.controllers.LoginController"
            prefWidth="500" prefHeight="420"
            style="-fx-background-color: #F1EFE8;">

    <center>
        <VBox alignment="CENTER" spacing="12"
              style="-fx-background-color: white; -fx-padding: 36; -fx-background-radius: 14;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, 2);"
              maxWidth="360">

            <Label text="🏨 Grand Hotel"
                   style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #185FA5;"/>

            <Label text="Sign in to your account"
                   style="-fx-font-size: 13px; -fx-text-fill: #888780;"/>

            <!-- Guest / Staff Tabs -->
            <HBox spacing="0" alignment="CENTER" style="-fx-padding: 6 0 6 0;">
                <ToggleButton fx:id="guestTab" text="  Guest  "
                              selected="true"
                              style="-fx-background-color: #185FA5; -fx-text-fill: white;
                                     -fx-font-weight: bold; -fx-background-radius: 8 0 0 8;
                                     -fx-border-color: #185FA5; -fx-border-width: 1;
                                     -fx-pref-width: 120; -fx-pref-height: 34;"/>
                <ToggleButton fx:id="staffTab" text="  Staff  "
                              style="-fx-background-color: white; -fx-text-fill: #185FA5;
                                     -fx-background-radius: 0 8 8 0;
                                     -fx-border-color: #185FA5; -fx-border-width: 1;
                                     -fx-pref-width: 120; -fx-pref-height: 34;"/>
            </HBox>

            <!-- Username -->
            <VBox spacing="4" maxWidth="Infinity">
                <Label text="Username"
                       style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #5F5E5A;"/>
                <TextField fx:id="usernameField" promptText="Enter your username"
                           style="-fx-pref-height: 36; -fx-background-radius: 8;
                                  -fx-border-radius: 8; -fx-border-color: #B4B2A9;
                                  -fx-border-width: 0.5; -fx-background-color: #F8F8F6;
                                  -fx-font-size: 13px; -fx-padding: 6 10 6 10;"
                           maxWidth="Infinity"/>
            </VBox>

            <!-- Password -->
            <VBox spacing="4" maxWidth="Infinity">
                <Label text="Password"
                       style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #5F5E5A;"/>
                <PasswordField fx:id="passwordField" promptText="••••••••"
                               style="-fx-pref-height: 36; -fx-background-radius: 8;
                                      -fx-border-radius: 8; -fx-border-color: #B4B2A9;
                                      -fx-border-width: 0.5; -fx-background-color: #F8F8F6;
                                      -fx-font-size: 13px; -fx-padding: 6 10 6 10;"
                               maxWidth="Infinity"/>
            </VBox>

            <!-- Error Label -->
            <Label fx:id="errorLabel" text=""
                   style="-fx-text-fill: #A32D2D; -fx-font-size: 12px;"
                   visible="false" maxWidth="Infinity"/>

            <!-- Sign In Button -->
            <Button fx:id="loginBtn" text="Sign In"
                    onAction="#handleLogin"
                    maxWidth="Infinity"
                    style="-fx-background-color: #185FA5; -fx-text-fill: white;
                           -fx-font-size: 14px; -fx-font-weight: bold;
                           -fx-background-radius: 8; -fx-pref-height: 42px;
                           -fx-cursor: hand;"/>

            <!-- Register link -->
            <HBox alignment="CENTER" spacing="4">
                <Label text="Don't have an account?"
                       style="-fx-font-size: 12px; -fx-text-fill: #888780;"/>
                <Hyperlink text="Register here" onAction="#goToRegister"
                           style="-fx-font-size: 12px; -fx-text-fill: #185FA5;"/>
            </HBox>

        </VBox>
    </center>

</BorderPane>
