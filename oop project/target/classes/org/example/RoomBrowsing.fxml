<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="project.oop.ui.controllers.RoomBrowsingController"
            prefWidth="900" prefHeight="600"
            style="-fx-background-color: #F1EFE8;">

    <!-- LEFT SIDEBAR (same as dashboard) -->
    <left>
        <VBox spacing="0"
              style="-fx-background-color: #185FA5; -fx-pref-width: 210px;">

            <VBox style="-fx-padding: 24 20 20 20; -fx-background-color: #0C447C;">
                <Label text="🏨 Grand Hotel"
                       style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                <Label text="Guest Portal"
                       style="-fx-font-size: 11px; -fx-text-fill: #B5D4F4;"/>
            </VBox>

            <VBox style="-fx-padding: 16 20 16 20; -fx-background-color: #1468B0;">
                <Label text="Welcome back," style="-fx-font-size: 11px; -fx-text-fill: #B5D4F4;"/>
                <Label fx:id="guestNameLabel" text="Guest"
                       style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            </VBox>

            <Button text="📊  Dashboard" onAction="#showDashboard"
                    maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #B5D4F4;
                           -fx-font-size: 13px; -fx-alignment: center-left;
                           -fx-padding: 12 20 12 20; -fx-border-width: 0;
                           -fx-background-radius: 0; -fx-cursor: hand;"/>

            <Button text="🛏  Browse Rooms" onAction="#showRooms"
                    maxWidth="Infinity"
                    style="-fx-background-color: rgba(255,255,255,0.18); -fx-text-fill: white;
                           -fx-font-size: 13px; -fx-alignment: center-left;
                           -fx-padding: 12 20 12 20; -fx-border-width: 0;
                           -fx-background-radius: 0; -fx-cursor: hand; -fx-font-weight: bold;"/>

            <Button text="📋  My Reservations" onAction="#showReservations"
                    maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #B5D4F4;
                           -fx-font-size: 13px; -fx-alignment: center-left;
                           -fx-padding: 12 20 12 20; -fx-border-width: 0;
                           -fx-background-radius: 0; -fx-cursor: hand;"/>

            <Button text="💳  Checkout" onAction="#showCheckout"
                    maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #B5D4F4;
                           -fx-font-size: 13px; -fx-alignment: center-left;
                           -fx-padding: 12 20 12 20; -fx-border-width: 0;
                           -fx-background-radius: 0; -fx-cursor: hand;"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Button text="🚪  Logout" onAction="#handleLogout"
                    maxWidth="Infinity"
                    style="-fx-background-color: rgba(163,45,45,0.7); -fx-text-fill: white;
                           -fx-font-size: 13px; -fx-alignment: center-left;
                           -fx-padding: 12 20 12 20; -fx-border-width: 0;
                           -fx-background-radius: 0; -fx-cursor: hand;"/>
        </VBox>
    </left>

    <!-- MAIN CONTENT -->
    <center>
        <VBox spacing="16" style="-fx-padding: 28;">

            <Label text="Browse Rooms"
                   style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2C2C2A;"/>

            <!-- Filter Bar -->
            <HBox spacing="12" alignment="CENTER_LEFT"
                  style="-fx-background-color: white; -fx-padding: 14;
                         -fx-background-radius: 10; -fx-border-color: #D3D1C7;
                         -fx-border-width: 0.5; -fx-border-radius: 10;">

                <Label text="Filter by:" style="-fx-font-size: 13px; -fx-text-fill: #5F5E5A; -fx-font-weight: bold;"/>

                <ComboBox fx:id="typeFilter" promptText="Room Type"
                          style="-fx-pref-height: 34; -fx-background-radius: 8;
                                 -fx-border-color: #B4B2A9; -fx-border-width: 0.5;
                                 -fx-background-color: #F8F8F6;"/>

                <ComboBox fx:id="amenityFilter" promptText="Amenity"
                          style="-fx-pref-height: 34; -fx-background-radius: 8;
                                 -fx-border-color: #B4B2A9; -fx-border-width: 0.5;
                                 -fx-background-color: #F8F8F6;"/>

                <TextField fx:id="maxPriceField" promptText="Max Price $"
                           style="-fx-pref-height: 34; -fx-pref-width: 110;
                                  -fx-background-radius: 8; -fx-border-color: #B4B2A9;
                                  -fx-border-width: 0.5; -fx-background-color: #F8F8F6;"/>

                <Button text="Apply Filter" onAction="#applyFilter"
                        style="-fx-background-color: #185FA5; -fx-text-fill: white;
                               -fx-font-size: 13px; -fx-background-radius: 8;
                               -fx-pref-height: 34; -fx-cursor: hand;"/>

                <Button text="Clear" onAction="#clearFilter"
                        style="-fx-background-color: transparent; -fx-text-fill: #888780;
                               -fx-font-size: 13px; -fx-border-color: #B4B2A9;
                               -fx-border-width: 0.5; -fx-border-radius: 8;
                               -fx-background-radius: 8; -fx-pref-height: 34; -fx-cursor: hand;"/>
            </HBox>

            <!-- Rooms Table -->
            <TableView fx:id="roomsTable" VBox.vgrow="ALWAYS"
                       style="-fx-background-color: white; -fx-background-radius: 12;
                              -fx-border-color: #D3D1C7; -fx-border-width: 0.5;
                              -fx-border-radius: 12;">
                <columns>
                    <TableColumn fx:id="colRoomNumber" text="Room #" prefWidth="80"/>
                    <TableColumn fx:id="colType" text="Type" prefWidth="120"/>
                    <TableColumn fx:id="colPrice" text="Price / Night" prefWidth="120"/>
                    <TableColumn fx:id="colCapacity" text="Capacity" prefWidth="90"/>
                    <TableColumn fx:id="colAmenities" text="Amenities" prefWidth="200"/>
                    <TableColumn fx:id="colStatus" text="Status" prefWidth="100"/>
                </columns>
            </TableView>

            <!-- Book Button -->
            <HBox alignment="CENTER_RIGHT">
                <Button text="📅  Book Selected Room" onAction="#bookRoom"
                        style="-fx-background-color: #185FA5; -fx-text-fill: white;
                               -fx-font-size: 14px; -fx-font-weight: bold;
                               -fx-background-radius: 8; -fx-pref-height: 42px;
                               -fx-padding: 0 20 0 20; -fx-cursor: hand;"/>
            </HBox>

        </VBox>
    </center>

</BorderPane>
