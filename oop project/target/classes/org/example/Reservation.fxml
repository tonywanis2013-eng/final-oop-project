<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="project.oop.ui.controllers.ReservationController"
            prefWidth="900" prefHeight="600"
            style="-fx-background-color: #F1EFE8;">

    <!-- LEFT SIDEBAR -->
    <left>
        <VBox spacing="0"
              style="-fx-background-color: #185FA5; -fx-pref-width: 210px; -fx-padding: 0;">

            <VBox style="-fx-padding: 24 20 20 20; -fx-background-color: #0C447C;">
                <Label text="🏨 Grand Hotel"
                       style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                <Label text="Guest Portal"
                       style="-fx-font-size: 11px; -fx-text-fill: #B5D4F4;"/>
            </VBox>

            <VBox style="-fx-padding: 16 20 16 20; -fx-background-color: #1468B0;">
                <Label text="Welcome back," style="-fx-font-size: 11px; -fx-text-fill: #B5D4F4;"/>
                <Label fx:id="guestNameLabel" text="Guest"
                       style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            </VBox>

            <Button text="📊  Dashboard" onAction="#showDashboard"
                    maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #B5D4F4;
                           -fx-font-size: 13px; -fx-alignment: CENTER_LEFT;
                           -fx-padding: 12 20 12 20; -fx-border-width: 0;
                           -fx-background-radius: 0; -fx-cursor: hand;"/>

            <Button text="🛏  Browse Rooms" onAction="#showRooms"
                    maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #B5D4F4;
                           -fx-font-size: 13px; -fx-alignment: CENTER_LEFT;
                           -fx-padding: 12 20 12 20; -fx-border-width: 0;
                           -fx-background-radius: 0; -fx-cursor: hand;"/>

            <Button text="📋  My Reservations" onAction="#showReservations"
                    maxWidth="Infinity"
                    style="-fx-background-color: rgba(255,255,255,0.18); -fx-text-fill: white;
                           -fx-font-size: 13px; -fx-alignment: CENTER_LEFT;
                           -fx-padding: 12 20 12 20; -fx-border-width: 0;
                           -fx-background-radius: 0; -fx-cursor: hand; -fx-font-weight: bold;"/>

            <Button text="💳  Checkout" onAction="#showCheckout"
                    maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #B5D4F4;
                           -fx-font-size: 13px; -fx-alignment: CENTER_LEFT;
                           -fx-padding: 12 20 12 20; -fx-border-width: 0;
                           -fx-background-radius: 0; -fx-cursor: hand;"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Button text="🚪  Logout" onAction="#handleLogout"
                    maxWidth="Infinity"
                    style="-fx-background-color: rgba(163,45,45,0.7); -fx-text-fill: white;
                           -fx-font-size: 13px; -fx-alignment: CENTER_LEFT;
                           -fx-padding: 12 20 12 20; -fx-border-width: 0;
                           -fx-background-radius: 0; -fx-cursor: hand;"/>
        </VBox>
    </left>

    <!-- MAIN CONTENT -->
    <center>
        <VBox spacing="20" style="-fx-padding: 28;">

            <Label text="My Reservations"
                   style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2C2C2A;"/>

            <!-- Filter Bar -->
            <HBox spacing="12" alignment="CENTER_LEFT"
                  style="-fx-background-color: white; -fx-padding: 14 18 14 18;
                         -fx-background-radius: 10; -fx-border-color: #D3D1C7;
                         -fx-border-width: 0.5; -fx-border-radius: 10;">
                <Label text="Filter by Status:"
                       style="-fx-font-size: 13px; -fx-text-fill: #888780;"/>
                <ComboBox fx:id="statusFilter" prefWidth="160"
                          onAction="#handleFilter"
                          style="-fx-font-size: 13px;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="+ New Reservation" onAction="#handleNewReservation"
                        style="-fx-background-color: #185FA5; -fx-text-fill: white;
                               -fx-font-size: 13px; -fx-background-radius: 6;
                               -fx-padding: 8 16 8 16; -fx-cursor: hand;"/>
            </HBox>

            <!-- Reservations Table -->
            <VBox spacing="0" VBox.vgrow="ALWAYS"
                  style="-fx-background-color: white; -fx-background-radius: 12;
                         -fx-border-color: #D3D1C7; -fx-border-width: 0.5; -fx-border-radius: 12;">

                <TableView fx:id="reservationTable" VBox.vgrow="ALWAYS"
                           style="-fx-background-color: transparent; -fx-border-width: 0;">
                    <columns>
                        <TableColumn fx:id="colId"       text="ID"         prefWidth="60"/>
                        <TableColumn fx:id="colRoom"     text="Room #"     prefWidth="80"/>
                        <TableColumn fx:id="colType"     text="Type"       prefWidth="100"/>
                        <TableColumn fx:id="colCheckIn"  text="Check-In"   prefWidth="120"/>
                        <TableColumn fx:id="colCheckOut" text="Check-Out"  prefWidth="120"/>
                        <TableColumn fx:id="colStatus"   text="Status"     prefWidth="110"/>
                        <TableColumn fx:id="colTotal"    text="Total"      prefWidth="90"/>
                    </columns>
                    <placeholder>
                        <Label text="No reservations found." style="-fx-text-fill: #888780;"/>
                    </placeholder>
                </TableView>
            </VBox>

            <!-- Action Buttons -->
            <HBox spacing="12">
                <Button text="❌  Cancel Selected" onAction="#handleCancel"
                        style="-fx-background-color: #C0392B; -fx-text-fill: white;
                               -fx-font-size: 13px; -fx-background-radius: 6;
                               -fx-padding: 9 18 9 18; -fx-cursor: hand;"/>
                <Button text="💳  Pay Selected" onAction="#handlePaySelected"
                        style="-fx-background-color: #27AE60; -fx-text-fill: white;
                               -fx-font-size: 13px; -fx-background-radius: 6;
                               -fx-padding: 9 18 9 18; -fx-cursor: hand;"/>
                <Label fx:id="statusLabel" text=""
                       style="-fx-font-size: 12px; -fx-text-fill: #C0392B;"/>
            </HBox>

        </VBox>
    </center>

    <!-- NEW RESERVATION DIALOG (hidden by default, shown via controller) -->

</BorderPane>
